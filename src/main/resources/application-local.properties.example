# =================================================
# InnerDerma 로컬 개발 전용 설정 샘플
# =================================================
# 이 파일을 복사해서 application-local.properties로 이름 바꾸고 실제 값을 채우세요.
# application-local.properties는 .gitignore에 포함되어 절대 커밋되지 않습니다.
#
# 서버 실행: .\gradlew.bat bootRun --args="--spring.profiles.active=local"

# DB 비밀번호
spring.datasource.password=YOUR_DB_PASSWORD_HERE

# OpenAI API Key (없으면 LLM fallback 모드로 동작)
openai.api-key=sk-YOUR_OPENAI_API_KEY_HERE

# SkinAge 서버 URL (기본값: http://localhost:8000)
# skinage.base-url=http://localhost:8000
