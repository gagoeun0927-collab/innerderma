# InnerDerma Production Environment Variables
# Copy to /opt/innerderma.env on the server and fill in values.

# MySQL
MYSQL_ROOT_PASSWORD=<openssl rand -hex 20>
DB_USER=innerderma_app
DB_PASSWORD=<openssl rand -hex 20>

# JWT
JWT_SECRET=<openssl rand -hex 32>

# OpenAI
OPENAI_API_KEY=sk-...

# SkinAge
SKINAGE_IMAGE=innerderma/skinage:latest
SKINAGE_BASE_URL=http://skinage:8000

# CORS (comma-separated, or * for demo)
CORS_ALLOWED_ORIGINS=*

# Storage
INNERDERMA_SKIN_CAPTURE_STORAGE_PATH=/data/skin-captures

# Timezone
TZ=Asia/Seoul
